{
  "mcpServers": {
    "bms-japan": {
      "type": "stdio",
      "command": "pc/.venv/Scripts/python.exe",
      "args": ["-m", "bms_japan.mcp_server"],
      "env": {}
    },
    "bms-japan-demo": {
      "type": "stdio",
      "command": "pc/.venv/Scripts/python.exe",
      "args": ["-m", "bms_japan.mcp_server"],
      "env": { "BMS_JAPAN_DEMO": "1" }
    }
  }
}
